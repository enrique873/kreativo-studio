---
import Base from '../../layouts/Base.astro';
---
<Base title="Diseno Web & E-commerce — Kreativo Studio">
<div class="nav-mobile" id="navMobile">
  <a href="kreativo-servicios.html">Servicios</a>
  <a href="#">Tienda</a><a href="#">Academia</a><a href="#">Blog</a><a href="#">Nosotros</a>
  <a href="https://wa.me/52XXXXXXXXXX" class="nav-mobile-cta">Agendar diagnóstico gratuito</a>
</div>

<!-- HERO -->
<section class="pdp-hero">
  <div class="pdp-hero-inner">
    <div>
      <div class="pdp-hero-breadcrumb">
        <a href="kreativo-mockup.html">Inicio</a><span>/</span>
        <a href="kreativo-servicios.html">Servicios</a><span>/</span>
        Diseño Web
      </div>
      <span class="hero-eyebrow">Diseño Web & E-commerce</span>
      <h1>Tu tienda merece convertir, no solo verse bien.</h1>
      <p>Desarrollamos en Shopify, Tienda Nube y VTEX con un solo criterio: que cada visitante tenga la mejor razón para comprar. Velocidad, UX y conversión desde el primer día.</p>
      <div class="hero-actions">
        <a href="https://wa.me/52XXXXXXXXXX?text=Quiero%20información%20sobre%20desarrollo%20web" class="btn-wa">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Cotizar mi proyecto
        </a>
        <a href="#que-incluye" class="btn-ghost">Ver qué incluye ↓</a>
      </div>
    </div>
    <div class="hero-device">
      <div class="device-desktop">
        <div class="device-bar">
          <div class="device-dot r"></div><div class="device-dot y"></div><div class="device-dot g"></div>
          <div class="device-url">mitienda.com · Shopify</div>
        </div>
        <div class="device-screen">
          <div class="screen-hero">
            <div class="screen-hero-accent"></div>
            <div class="screen-hero-text">
              <div class="screen-hero-tag">NUEVA COLECCIÓN</div>
              <div class="screen-hero-h">Compra ahora<br>y recibe hoy</div>
            </div>
          </div>
          <div class="screen-body">
            <div class="screen-row">
              <div class="screen-card"><div class="screen-card-img"></div><div class="screen-card-title"></div><div class="screen-card-price"></div></div>
              <div class="screen-card"><div class="screen-card-img"></div><div class="screen-card-title"></div><div class="screen-card-price"></div></div>
              <div class="screen-card"><div class="screen-card-img"></div><div class="screen-card-title"></div><div class="screen-card-price"></div></div>
            </div>
          </div>
          <div class="screen-metrics">
            <div class="screen-metric"><div class="screen-metric-val"><em>+127</em>%</div><div class="screen-metric-lab">Conversión</div></div>
            <div class="screen-metric"><div class="screen-metric-val"><em>98</em></div><div class="screen-metric-lab">PageSpeed</div></div>
            <div class="screen-metric"><div class="screen-metric-val"><em>1.2</em>s</div><div class="screen-metric-lab">Carga</div></div>
            <div class="screen-metric"><div class="screen-metric-val"><em>-41</em>%</div><div class="screen-metric-lab">Abandono</div></div>
          </div>
        </div>
      </div>
      <div class="device-mobile" style="position:absolute;bottom:-16px;right:-24px;width:96px;">
        <div class="mob-notch"></div>
        <div class="mob-screen">
          <div class="mob-hero"></div>
          <div class="mob-card"></div>
          <div class="mob-cta"></div>
        </div>
        <div class="mob-score" style="position:absolute;top:-14px;right:-14px;">
          <div class="mob-score-val">98</div>
          <div class="mob-score-lab">Score</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PLATFORMS -->
<section class="section-gap">
  <div class="section-wrap">
    <div class="section-tag">Plataformas</div>
    <h2 class="section-heading">Partners certificados en las tres plataformas líderes de e-commerce.</h2>
    <p class="section-sub">No trabajamos con una sola plataforma y te la vendemos sin importar tu caso. Recomendamos lo que más le conviene a tu negocio.</p>
    <div class="platforms-grid">
      <div class="platform-card">
        <div class="platform-logo shopify">Shopify</div>
        <span class="platform-badge partner">Shopify Partner</span>
        <p class="platform-desc">La plataforma de e-commerce más usada en el mundo. Excelente para marcas en crecimiento con un catálogo claro y necesidad de escalar rápido.</p>
        <div class="platform-best">Ideal para: <span>e-commerce DTC, marcas emergentes, retail con catálogos medianos</span></div>
      </div>
      <div class="platform-card">
        <div class="platform-logo tiendanube">Tienda Nube</div>
        <span class="platform-badge partner">Partner Certificado</span>
        <p class="platform-desc">La alternativa regional con soporte en español, medios de pago locales integrados y tarifas competitivas para el mercado mexicano y latinoamericano.</p>
        <div class="platform-best">Ideal para: <span>negocios locales, presupuesto ajustado, primeras tiendas en línea</span></div>
      </div>
      <div class="platform-card">
        <div class="platform-logo vtex">VTEX</div>
        <span class="platform-badge partner">Partner VTEX</span>
        <p class="platform-desc">Plataforma enterprise para operaciones de gran escala. Multi-tienda, multi-idioma, integraciones ERP y lógicas de negocio complejas.</p>
        <div class="platform-best">Ideal para: <span>retail enterprise, cadenas con múltiples marcas, catálogos de miles de SKUs</span></div>
      </div>
    </div>
  </div>
</section>

<!-- WHAT WE DO -->
<section class="section-gap" style="background:var(--off-white);">
  <div class="section-wrap">
    <div class="section-tag">Qué hacemos</div>
    <h2 class="section-heading">Más que diseño.<br>Un sistema de conversión.</h2>
    <p class="section-sub">Cada decisión de diseño y desarrollo tiene un objetivo detrás: que más visitantes compren, y que compren más.</p>
    <div class="services-detail">
      <div class="sdc">
        <div class="sdc-icon"><svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg></div>
        <div class="sdc-title">Desarrollo de tiendas</div>
        <div class="sdc-desc">Construcción o rediseño completo de tu e-commerce con identidad de marca, UX optimizado y configuración técnica correcta desde el inicio.</div>
        <ul class="sdc-list">
          <li>Diseño UI/UX personalizado</li>
          <li>Configuración de catálogo y pagos</li>
          <li>Integración con ERP y logística</li>
          <li>Migración desde otras plataformas</li>
        </ul>
      </div>
      <div class="sdc">
        <div class="sdc-icon"><svg viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg></div>
        <div class="sdc-title">Landing pages de alta conversión</div>
        <div class="sdc-desc">Páginas diseñadas específicamente para campañas de paid media, con estructura persuasiva, velocidad máxima y tracking preciso.</div>
        <ul class="sdc-list">
          <li>Copy orientado a conversión</li>
          <li>Diseño sin distracciones</li>
          <li>A/B testing desde el lanzamiento</li>
          <li>Integración con Meta y Google Ads</li>
        </ul>
      </div>
      <div class="sdc">
        <div class="sdc-icon"><svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></div>
        <div class="sdc-title">CRO y optimización</div>
        <div class="sdc-desc">Análisis sistemático del comportamiento del usuario para identificar fricciones y mejorar la tasa de conversión sin aumentar el tráfico.</div>
        <ul class="sdc-list">
          <li>Mapas de calor y grabaciones</li>
          <li>Optimización de checkout</li>
          <li>Reducción de abandono de carrito</li>
          <li>Pruebas A/B con datos reales</li>
        </ul>
      </div>
      <div class="sdc">
        <div class="sdc-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg></div>
        <div class="sdc-title">Velocidad y SEO técnico</div>
        <div class="sdc-desc">Una tienda lenta pierde ventas. Optimizamos para que cargue en menos de 2 segundos y esté correctamente indexada en buscadores.</div>
        <ul class="sdc-list">
          <li>Core Web Vitals optimization</li>
          <li>Compresión y lazy loading</li>
          <li>Estructura de URLs y metadatos</li>
          <li>Schema markup para productos</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- PROCESS -->
<section class="process-section section-gap-sm">
  <div class="section-wrap">
    <div class="section-tag" style="background:rgba(0,200,202,0.12);border-color:rgba(0,200,202,0.25);">Proceso de trabajo</div>
    <h2 class="section-heading" style="color:var(--white);">De la idea al lanzamiento en 6 etapas.</h2>
    <div class="process-grid">
      <div class="process-step">
        <div class="process-step-dot">01</div>
        <div class="process-step-name">Discovery</div>
        <div class="process-step-desc">Entendemos el negocio, el cliente y los objetivos antes de diseñar una sola pantalla</div>
      </div>
      <div class="process-step">
        <div class="process-step-dot">02</div>
        <div class="process-step-name">Wireframes</div>
        <div class="process-step-desc">Estructura y flujos de usuario validados antes de invertir en diseño visual</div>
      </div>
      <div class="process-step">
        <div class="process-step-dot">03</div>
        <div class="process-step-name">Diseño UI</div>
        <div class="process-step-desc">Identidad visual aplicada con criterio de conversión en cada elemento</div>
      </div>
      <div class="process-step">
        <div class="process-step-dot">04</div>
        <div class="process-step-name">Desarrollo</div>
        <div class="process-step-desc">Implementación en la plataforma elegida con código limpio y documentado</div>
      </div>
      <div class="process-step">
        <div class="process-step-dot">05</div>
        <div class="process-step-name">QA & Testing</div>
        <div class="process-step-desc">Pruebas en todos los dispositivos y navegadores antes del go-live</div>
      </div>
      <div class="process-step">
        <div class="process-step-dot">06</div>
        <div class="process-step-name">Lanzamiento</div>
        <div class="process-step-desc">Go-live acompañado con soporte inmediato y período de garantía incluido</div>
      </div>
    </div>
  </div>
</section>

<!-- RESULTS -->
<section class="section-gap">
  <div class="section-wrap">
    <div class="section-tag">Resultados típicos</div>
    <h2 class="section-heading">Un sitio bien construido<br>se paga solo.</h2>
    <p class="section-sub">Estos son los resultados que una tienda optimizada genera de forma consistente frente a una con problemas de UX y velocidad.</p>
    <div class="results-grid">
      <div class="result-card">
        <div class="result-num">+<span>127</span>%</div>
        <div class="result-label">Incremento en tasa de conversión tras rediseño y optimización</div>
      </div>
      <div class="result-card">
        <div class="result-num"><span>98</span></div>
        <div class="result-label">PageSpeed Score promedio en proyectos entregados</div>
      </div>
      <div class="result-card">
        <div class="result-num">-<span>41</span>%</div>
        <div class="result-label">Reducción en tasa de abandono de carrito post-optimización</div>
      </div>
      <div class="result-card">
        <div class="result-num"><span>1.2</span>s</div>
        <div class="result-label">Tiempo de carga promedio en proyectos con optimización de velocidad</div>
      </div>
    </div>
  </div>
</section>

<!-- INCLUDES -->
<section class="section-gap" id="que-incluye" style="background:var(--off-white);">
  <div class="section-wrap">
    <div class="section-tag">Qué incluye</div>
    <h2 class="section-heading">Todo lo que necesita<br>tu proyecto para triunfar.</h2>
    <div class="includes-grid">
      <div class="includes-col">
        <h3>Diseño y desarrollo</h3>
        <ul class="includes-list">
          <li>Auditoría del sitio o tienda actual (si existe)</li>
          <li>Wireframes y arquitectura de información</li>
          <li>Diseño UI personalizado con identidad de marca</li>
          <li>Desarrollo front-end responsive (desktop, tablet y móvil)</li>
          <li>Configuración completa de la plataforma elegida</li>
          <li>Integración de medios de pago y logística</li>
          <li>Migración de productos, clientes y órdenes si aplica</li>
        </ul>
      </div>
      <div class="includes-col">
        <h3>Optimización y entrega</h3>
        <ul class="includes-list">
          <li>Optimización de velocidad y Core Web Vitals</li>
          <li>SEO técnico: metadatos, schema markup y URLs</li>
          <li>Configuración de Google Analytics 4 y píxeles</li>
          <li>301 redirects si hay migración de dominio o plataforma</li>
          <li>Pruebas QA en múltiples dispositivos y navegadores</li>
          <li>Capacitación para administrar la tienda de forma autónoma</li>
          <li>Período de garantía post-lanzamiento incluido</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- IDEAL CLIENT -->
<section class="section-gap">
  <div class="section-wrap">
    <div class="section-tag">Para quién es</div>
    <h2 class="section-heading">Este servicio es para ti<br>si encajas aquí.</h2>
    <div class="ideal-grid">
      <div class="ideal-yes">
        <span class="ideal-label">Buen fit</span>
        <ul class="ideal-list">
          <li>Tienes un negocio con producto validado y quieres vender en línea o mejorar lo que ya tienes</li>
          <li>Sabes que tu sitio actual tiene problemas de velocidad, conversión o diseño y quieres resolverlos bien</li>
          <li>Buscas un partner técnico que entienda tanto de diseño como de negocio digital</li>
          <li>Planeas invertir en publicidad digital y necesitas que tu destino de tráfico convierta</li>
          <li>Quieres una tienda que puedas administrar sin depender de un desarrollador para cada cambio</li>
        </ul>
      </div>
      <div class="ideal-no">
        <span class="ideal-label">No es el momento</span>
        <ul class="ideal-list">
          <li>No tienes definido qué vas a vender ni a quién</li>
          <li>Buscas el sitio más barato posible sin importar la calidad</li>
          <li>Esperas lanzar en menos de dos semanas sin haber definido el diseño ni el contenido</li>
          <li>No tienes fotos de producto ni textos de venta listos o en proceso</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="faq-section section-gap">
  <div class="section-wrap">
    <div class="section-tag">Preguntas frecuentes</div>
    <h2 class="section-heading">Lo que nos preguntan antes de iniciar un proyecto.</h2>
    <div class="faq-list">
      <div class="faq-item">
        <button class="faq-q" onclick="toggleFaq(this)">¿Cuánto cuesta desarrollar una tienda en Shopify en México?<span class="faq-arrow"><svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></span></button>
        <div class="faq-a"><p>Depende del alcance: número de páginas, integraciones, nivel de personalización y si incluye migración. Trabajamos con proyectos desde $25,000 MXN para desarrollos básicos hasta proyectos enterprise de mayor inversión. El diagnóstico inicial es gratuito y te entregamos una propuesta detallada antes de cualquier compromiso.</p></div>
      </div>
      <div class="faq-item">
        <button class="faq-q" onclick="toggleFaq(this)">¿Qué plataforma es mejor para mi negocio: Shopify, Tienda Nube o VTEX?<span class="faq-arrow"><svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></span></button>
        <div class="faq-a"><p>Depende del tamaño y necesidades de tu operación. Shopify es ideal para la mayoría de e-commerces en crecimiento. Tienda Nube es una alternativa regional sólida para el mercado mexicano. VTEX es para operaciones enterprise con catálogos grandes o integraciones complejas. Somos partners de las tres y recomendamos sin sesgo la que más te conviene.</p></div>
      </div>
      <div class="faq-item">
        <button class="faq-q" onclick="toggleFaq(this)">¿Cuánto tiempo tarda en desarrollarse una tienda en línea?<span class="faq-arrow"><svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></span></button>
        <div class="faq-a"><p>Un proyecto estándar de Shopify toma entre 4 y 8 semanas desde el kick-off hasta el lanzamiento. Proyectos con integraciones de ERP, migración de catálogos grandes o desarrollos VTEX pueden tomar entre 8 y 16 semanas. Siempre entregamos un cronograma detallado antes de iniciar.</p></div>
      </div>
      <div class="faq-item">
        <button class="faq-q" onclick="toggleFaq(this)">¿Qué es CRO y por qué importa para mi tienda?<span class="faq-arrow"><svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></span></button>
        <div class="faq-a"><p>CRO (Conversion Rate Optimization) es el proceso de mejorar el porcentaje de visitantes que se convierten en compradores. Una tienda con buen tráfico pero baja conversión pierde dinero en cada visita. Mejoras en velocidad, UX del checkout y diseño pueden incrementar la conversión entre 30% y 150% sin gastar más en publicidad.</p></div>
      </div>
      <div class="faq-item">
        <button class="faq-q" onclick="toggleFaq(this)">¿Pueden migrar mi tienda existente sin perder datos ni posicionamiento SEO?<span class="faq-arrow"><svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></span></button>
        <div class="faq-a"><p>Sí. Manejamos migraciones desde WooCommerce, Magento, Wix y otras plataformas. El proceso incluye migración de productos, clientes y órdenes históricas, configuración de 301 redirects para preservar el SEO y pruebas exhaustivas antes del go-live.</p></div>
      </div>
      <div class="faq-item">
        <button class="faq-q" onclick="toggleFaq(this)">¿Ofrecen soporte y mantenimiento después del lanzamiento?<span class="faq-arrow"><svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></span></button>
        <div class="faq-a"><p>Sí. Todos los proyectos incluyen un período de garantía post-lanzamiento para corrección de bugs sin costo adicional. Además ofrecemos planes de mantenimiento mensual con actualizaciones, optimizaciones de velocidad, ajustes de diseño y soporte técnico continuo.</p></div>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="pdp-cta">
  <div class="section-tag">Cotiza tu proyecto</div>
  <h2 class="section-heading">Tu tienda debería trabajar para ti, no al revés.</h2>
  <p>Cuéntanos qué necesitas y en menos de 24 horas te enviamos una propuesta con alcance, plataforma recomendada y tiempo estimado.</p>
  <div class="pdp-cta-actions">
    <a href="https://wa.me/52XXXXXXXXXX?text=Hola%2C%20quiero%20cotizar%20un%20proyecto%20de%20dise%C3%B1o%20web" class="btn-wa">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      Cotizar por WhatsApp
    </a>
    <a href="kreativo-servicios.html" class="btn-ghost" style="color:rgba(255,255,255,0.45);">Ver todos los servicios</a>
  </div>
  <p class="pdp-cta-note">Propuesta en menos de 24 horas. Sin compromiso.</p>
</section>

<!-- FOOTER -->

<script>
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Diseño Web y E-commerce",
      "provider": { "@type": "Organization", "name": "Kreativo Studio", "url": "https://kreativostudio.com" },
