// Gradients / colors for related cards
const GRADIENTS = ['linear-gradient(135deg,#1D1D1F,#2d2d30)','linear-gradient(135deg,#1877F2,#0d5bbd)','linear-gradient(135deg,#667eea,#764ba2)','linear-gradient(135deg,#010101,#1a1a1a)','linear-gradient(135deg,#f093fb,#f5576c)','linear-gradient(135deg,#4285F4,#0F9D58)','linear-gradient(135deg,#4facfe,#00f2fe)','linear-gradient(135deg,#fa709a,#fee140)','linear-gradient(135deg,#43e97b,#38f9d7)','linear-gradient(135deg,#a18cd1,#fbc2eb)','linear-gradient(135deg,#00C8CA,#0089A6)','linear-gradient(135deg,#fccb90,#d57eeb)'];

function loadProduct(idx) {
  const p = PRODUCTS[parseInt(idx)];
  document.getElementById('pageTitle').textContent = p.name + ' | Kreativo Studio';
  document.getElementById('breadcrumbName').textContent = p.name;
  document.getElementById('heroVisual').style.background = p.gradient;
  const badge = document.getElementById('heroBadge');
  badge.textContent = p.badgeText;
  badge.className = 'phv-badge ' + p.badge;
  const iconBox = document.getElementById('heroIconBox');
  iconBox.className = 'phv-icon-box' + (p.iconDark ? ' dark-icon' : '');
  document.getElementById('heroIcon').innerHTML = p.icon;
  const lbl = document.getElementById('heroLabel');
  lbl.textContent = p.iconLabel;
  lbl.className = 'phv-title' + (p.iconDark ? ' dark-txt' : '');
  document.getElementById('productCat').textContent = p.cat;
  document.getElementById('productTitle').textContent = p.name;
  document.getElementById('productIntro').textContent = p.intro;
  document.getElementById('boxPrice').innerHTML = p.price + ' <small>MXN</small>';
  // includes
  document.getElementById('includesList').innerHTML = p.includes.map(i => `<li>${i}</li>`).join('');
  // preview
  document.getElementById('previewGrid').innerHTML = p.preview.map(pr => `<div class="preview-item"><div class="preview-item-num">${pr.num}</div>${pr.txt}</div>`).join('');
  // for whom
  document.getElementById('forYesList').innerHTML = p.forYes.map(i => `<li>${i}</li>`).join('');
  document.getElementById('forNoList').innerHTML = p.forNo.map(i => `<li>${i}</li>`).join('');
  // tags
  document.getElementById('boxTags').innerHTML = p.tags.map(t => `<span class="bb-tag">${t}</span>`).join('');
  // related: 3 random other products
  const others = PRODUCTS.filter(x => x.id !== p.id).sort(() => 0.5 - Math.random()).slice(0, 3);
  document.getElementById('relatedGrid').innerHTML = others.map(r => `
    <div class="related-card" onclick="document.getElementById('productSelector').value=${r.id};loadProduct(${r.id});window.scrollTo(0,0)">
      <div class="rc-visual" style="background:${GRADIENTS[r.id]}">
        <svg viewBox="0 0 24 24">${r.icon}</svg>
      </div>
      <div class="rc-body">
        <div class="rc-cat">${r.cat}</div>
        <div class="rc-name">${r.name}</div>
      </div>
      <div class="rc-footer">
        <span class="rc-price">${r.price} <small style="font-size:10px;color:var(--mid-gray);font-weight:400">MXN</small></span>
        <span class="rc-btn">Ver producto →</span>
      </div>
    </div>`).join('');
  window.scrollTo(0,0);
}

function toggleMenu() { document.getElementById('navMobile').classList.toggle('open'); }

// Init
loadProduct(0);
