  <a href="https://wa.me/52XXXXXXXXXX" class="nav-mobile-cta">Agendar diagnóstico gratuito</a>
</div>

<!-- HERO -->
<section class="store-hero">
  <div class="store-hero-inner">
    <div class="store-hero-breadcrumb"><a href="kreativo-mockup.html">Inicio</a><span>/</span>Tienda</div>
    <span class="store-hero-eyebrow">Recursos Digitales</span>
    <h1>Herramientas que usan los mejores equipos de marketing.</h1>
    <p>Plantillas, kits de auditoría, guías y checklists diseñados para directores de marketing y e-commerce que quieren resultados sin reinventar la rueda.</p>
    <div class="hero-trust">
