<nav id="ks-nav">
  <a href="/" class="nav-logo">
    <div class="nav-logo-mark"><span>KS</span></div>
    <span class="nav-wordmark">Kreativo Studio</span>
  </a>
  <ul class="nav-links">
    <li><a href="/servicios">Servicios</a></li>
    <li><a href="/nosotros#metodologia">Metodolog&iacute;a</a></li>
    <li><a href="/tienda">Recursos</a></li>
    <li><a href="/academia">Academia</a></li>
    <li><a href="https://wa.me/52XXXXXXXXXX" class="nav-cta" target="_blank">Hablemos &rarr;</a></li>
  </ul>
  <button class="nav-hamburger" id="ks-menu-btn" aria-label="Abrir men&uacute;" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</nav>

<div class="nav-mobile-menu" id="ks-mobile-menu">
  <ul>
    <li><a href="/servicios">Servicios</a></li>
    <li><a href="/nosotros#metodologia">Metodolog&iacute;a</a></li>
    <li><a href="/tienda">Recursos</a></li>
    <li><a href="/academia">Academia</a></li>
    <li><a href="https://wa.me/52XXXXXXXXXX" class="mobile-nav-cta" target="_blank">Hablemos &rarr;</a></li>
  </ul>
</div>

<script is:inline>
  var btn = document.getElementById('ks-menu-btn');
  var menu = document.getElementById('ks-mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', function() {
      var open = menu.classList.toggle('open');
      btn.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', open);
      document.body.style.overflow = open ? 'hidden' : '';
    });
    menu.querySelectorAll('a').forEach(function(a) {
      a.addEventListener('click', function() {
        menu.classList.remove('open');
        btn.classList.remove('open');
        btn.setAttribute('aria-expanded', false);
        document.body.style.overflow = '';
      });
    });
  }
</script>
