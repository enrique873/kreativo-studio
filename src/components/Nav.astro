<style>
/* ── DROPDOWN NAV ── */
.nav-item { position: relative; }

.nav-item > a {
  display: flex; align-items: center; gap: 4px;
}

.nav-chevron {
  width: 12px; height: 12px;
  stroke: currentColor; fill: none; stroke-width: 2.5;
  transition: transform 0.2s;
  opacity: 0.5;
}

.nav-item:hover .nav-chevron { transform: rotate(180deg); opacity: 1; }

.nav-dropdown {
  position: absolute;
  top: calc(100% + 10px);
  left: 50%;
  transform: translateX(-50%);
  min-width: 220px;
  background: #fff;
  border: 1px solid var(--light-gray);
  border-radius: var(--radius);
  box-shadow: 0 8px 32px rgba(0,0,0,0.1);
  padding: 8px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.18s, transform 0.18s;
  transform: translateX(-50%) translateY(-4px);
  z-index: 200;
}

.nav-item:hover .nav-dropdown,
.nav-item:focus-within .nav-dropdown {
  opacity: 1;
  pointer-events: auto;
  transform: translateX(-50%) translateY(0);
}

/* Arrow pointer */
.nav-dropdown::before {
  content: '';
  position: absolute;
  top: -5px; left: 50%; transform: translateX(-50%);
  width: 10px; height: 10px;
  background: #fff;
  border-left: 1px solid var(--light-gray);
  border-top: 1px solid var(--light-gray);
  transform: translateX(-50%) rotate(45deg);
}

.nav-drop-item {
  display: block;
  padding: 10px 14px;
  border-radius: 8px;
  text-decoration: none;
  color: var(--dark);
  font-size: 13px;
  font-weight: 400;
  transition: background 0.15s, color 0.15s;
  white-space: nowrap;
}

.nav-drop-item:hover { background: var(--off-white); color: var(--darker); }

.nav-drop-item .drop-label {
  display: block;
  font-weight: 500;
  color: var(--darker);
  font-family: var(--font-heading);
  font-size: 13px;
  letter-spacing: 0.01em;
}

.nav-drop-item .drop-sub {
  display: block;
  font-size: 11px;
  color: var(--mid-gray);
  margin-top: 1px;
  font-weight: 300;
}

.nav-drop-divider {
  height: 1px;
  background: var(--light-gray);
  margin: 6px 8px;
}

.nav-drop-item.overview {
  border-bottom: 1px solid var(--light-gray);
  margin-bottom: 4px;
  padding-bottom: 12px;
}
.nav-drop-item.overview .drop-label { color: var(--cyan); }

/* Mobile sub-items */
.nav-mobile-sub {
  list-style: none;
  padding: 0 0 8px 16px;
  display: none;
  flex-direction: column;
  gap: 0;
}
.nav-mobile-sub.open { display: flex; }
.nav-mobile-sub li a {
  font-family: var(--font-body) !important;
  font-size: 16px !important;
  font-weight: 400 !important;
  color: rgba(255,255,255,0.55) !important;
  border-bottom: 1px solid rgba(255,255,255,0.04) !important;
  padding: 10px 0 !important;
}
.nav-mobile-sub li a:hover { color: var(--cyan) !important; }

.mobile-toggle-btn {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%;
  background: none; border: none; cursor: pointer; padding: 0;
}
.mobile-toggle-btn > a {
  font-family: var(--font-heading);
  font-size: 28px;
  font-weight: 700;
  color: rgba(255,255,255,0.85);
  text-decoration: none;
  padding: 12px 0;
  border-bottom: 1px solid rgba(255,255,255,0.07);
  flex: 1;
  text-align: left;
  transition: color 0.2s;
  display: block;
}
.mobile-toggle-btn > a:hover { color: var(--cyan); }
.mobile-toggle-icon {
  width: 24px; height: 24px;
  stroke: rgba(255,255,255,0.4); fill: none; stroke-width: 2.5;
  transition: transform 0.25s;
  flex: 0 0 24px; margin-left: 8px; margin-bottom: 12px;
}
.mobile-toggle-btn.open .mobile-toggle-icon { transform: rotate(180deg); }
</style>

